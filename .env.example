# Copy to .env and replace every placeholder before real use.
# Never commit .env. Never put these values in the web or mobile apps.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://sakuna:sakuna@localhost:5432/sakuna
JWT_SECRET=dev-only-change-me
SERVICE_TOKEN=dev-service-token

OPENAI_API_KEY=
OPENAI_MODEL_SMALL=gpt-4o-mini
OPENAI_MODEL_BALANCED=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional. Leave at 0 until you verify current provider prices.
# Estimated cost is stored only when these are set.
OPENAI_INPUT_PRICE_PER_MILLION=0
OPENAI_OUTPUT_PRICE_PER_MILLION=0

CORS_ORIGINS=http://localhost:3000,http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:8000
