# Production environment for /opt/sakuna/.env on the VM (chmod 600). Never commit the real file.
# Generate secrets with:  openssl rand -hex 32

# --- compose / deploy ---
GHCR_OWNER=your-github-username-lowercase
SITE_ADDRESS=sakuna.example.com
TAG=set-by-deploy-sh

# --- database ---
POSTGRES_USER=sakuna
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=sakuna
DATABASE_URL=postgresql+psycopg://sakuna:CHANGE_ME_LONG_RANDOM@db:5432/sakuna

# --- backend ---
ENVIRONMENT=production
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM
CORS_ORIGINS=https://sakuna.example.com

# --- AI (optional; app works without a key) ---
OPENAI_API_KEY=
OPENAI_MODEL_SMALL=gpt-4o-mini
OPENAI_MODEL_BALANCED=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- backups (optional) ---
# Public key from `age-keygen`; keep the private key OFF the server.
BACKUP_AGE_RECIPIENT=
# rclone remote, e.g. "gdrive:sakuna-backups". Leave empty to keep backups on the VM only.
BACKUP_RCLONE_REMOTE=
# Dead-man's-switch URL pinged after a successful backup (e.g. a healthchecks.io check).
BACKUP_HEARTBEAT_URL=
