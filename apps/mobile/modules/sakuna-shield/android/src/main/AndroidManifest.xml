<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!-- App monitor: today's screen time per app (user grants "Usage access" in Settings). -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

  <!-- Lets the app list launchable apps to choose from (Android 11+ package visibility). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <!-- "Block unsupported browsers": find every app that opens web links. -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:scheme="http" />
    </intent>
    <!-- Home screens are left out of screen time. -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
  </queries>

  <application>
    <!-- App and website blocking. Runs only after the user turns it on in Accessibility settings. -->
    <service
        android:name="expo.modules.sakunashield.ShieldAccessibilityService"
        android:exported="false"
        android:label="@string/sakuna_shield_service_label"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/sakuna_shield_accessibility" />
    </service>

    <activity
        android:name="expo.modules.sakunashield.BlockActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:launchMode="singleTask"
        android:taskAffinity="expo.modules.sakunashield.block"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
  </application>
</manifest>
