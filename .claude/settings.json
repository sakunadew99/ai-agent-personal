{
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make test)",
      "Bash(make test-api)",
      "Bash(make test-mcp)",
      "Bash(make test-web)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make ps)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./infra/.env)",
      "Read(./secrets/**)",
      "Read(./**/*.keystore)",
      "Read(./backups/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm *)"
    ]
  }
}
